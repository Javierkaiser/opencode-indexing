node_modules/
test/.state/
*.log
.lancedb/
*.tmp
*.tgz
coverage/

# Local CodeGraph index (machine-specific, never published)
.codegraph/

# Working notes kept local, not published. The whole folder, so a new note
# stays local by default instead of needing its own line here.
docs/

# Benchmark manifest: maps anonymous labels to real paths, so it must not be published
bench/projects.local.json

# The Desktop GUI bundle. Generated by `npm run build:gui`, which `prepack`
# runs, so it exists in every packed tarball without being tracked: a committed
# build artifact is one that can drift from its source and still look valid.
dist/

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
