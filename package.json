{
  "name": "@javierkaiser/opencode-indexing",
  "version": "0.5.0",
  "description": "OpenCode plugin: semantic code search that reuses Kilo Code indexes (Qdrant/LanceDB) and maintains its own independent index",
  "license": "MIT",
  "author": "Carlos Javier Lust <javierkaiser@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Javierkaiser/opencode-indexing.git"
  },
  "homepage": "https://github.com/Javierkaiser/opencode-indexing#readme",
  "bugs": {
    "url": "https://github.com/Javierkaiser/opencode-indexing/issues"
  },
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "semantic-search",
    "code-search",
    "codebase-indexing",
    "embeddings",
    "qdrant",
    "lancedb",
    "kilo-code"
  ],
  "exports": {
    ".": "./index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./tui.ts"
  },
  "bin": {
    "opencode-indexing": "./install.mjs"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "tui",
    "src",
    "tsconfig.json",
    "install.mjs",
    "install.sh",
    "install.ps1",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"test/*.test.ts\"",
    "test:integration": "node --test \"test/integration/*.test.ts\"",
    "test": "npm run typecheck && npm run test:unit",
    "bench": "node bench/run.mjs --strategy grep"
  },
  "engines": {
    "node": ">=22.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "ignore": "^7.0.5",
    "mini-semantic-search": "^0.1.0"
  },
  "optionalDependencies": {
    "@lancedb/lancedb": "0.40.0",
    "apache-arrow": "18.1.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.0",
    "@opencode/theme": "^2.2.0",
    "@opentui/core": "^0.7.0",
    "@opentui/solid": "^0.7.0",
    "@types/node": "^22.19.0",
    "solid-js": "^1.9.12",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opencode/theme": ">=2.0.23",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
